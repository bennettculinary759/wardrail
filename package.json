{
  "name": "wardrail",
  "version": "0.3.0",
  "description": "Local security scanner for vibe-coded apps: catch API keys, Git-history secrets, unsafe MCP, and AI agent instructions before commit.",
  "type": "module",
  "bin": {
    "wardrail": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "scan": "tsx src/cli/index.ts scan",
    "scan:self": "tsx src/cli/index.ts scan . --no-color",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build && node dist/cli/index.js scan . --no-color",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "ai-agent",
    "ai-agent-security",
    "ai-security",
    "api-key",
    "claude-code",
    "codex",
    "cursor",
    "git-history",
    "mcp",
    "mcp-security",
    "pre-commit",
    "prompt-injection",
    "secret-scanner",
    "secrets-scanning",
    "security",
    "static-analysis",
    "supply-chain-security",
    "vibe-coding",
    "vibecoding"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3196973848/wardrail.git"
  },
  "homepage": "https://github.com/3196973848/wardrail#readme",
  "bugs": {
    "url": "https://github.com/3196973848/wardrail/issues"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
